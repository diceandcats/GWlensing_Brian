universe       = vanilla
getenv         = True

should_transfer_files = NO
project_dir    = $Fp($(SUBMIT_FILE))
initialdir     = $(project_dir)

executable     = $(project_dir)run_mismatched_pairs.sh
simulation_model = cats
csv              = model_mismatch_data/src_pos_tidy_xyz_$(simulation_model)_3img.csv
arguments        = $(simulation_model) $(csv) $(cluster)
environment    = "PYTHON=$ENV(HOME)/.venv/bin/python OUT_DIR=out_mismatched_models REQUEST_CPUS=$(request_cpus) DE_PROCS=$(request_cpus) MCMC_PROCS=$(request_cpus)"

request_cpus   = 16
request_memory = 10 GB
request_disk   = 8 GB
requirements   = (TARGET.OpSys == "LINUX")

output         = logs/mismatched_$(simulation_model)_cluster$(cluster).out
error          = logs/mismatched_$(simulation_model)_cluster$(cluster).err
log            = logs/mismatched.log

queue cluster from (
0
1
2
3
4
5
)
