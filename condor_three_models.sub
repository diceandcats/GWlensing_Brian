universe       = vanilla
getenv         = True

should_transfer_files = NO
initialdir     = $ENV(HOME)/GWlensing_Brian

executable     = $ENV(HOME)/GWlensing_Brian/run_three_models.sh
arguments      = $(row)

environment    = "CSV=src_pos_tidy_xyz_copy.csv OUT_DIR=out_three_models REQUEST_CPUS=$(request_cpus) DE_PROCS=$(request_cpus) MCMC_PROCS=$(request_cpus)"

request_cpus   = 16
request_memory = 10 GB
request_disk   = 8 GB
requirements   = (TARGET.OpSys == "LINUX")

output         = logs/three_models_row$(row).out
error          = logs/three_models_row$(row).err
log            = logs/simulation_three_models.log

queue row from (
0
5
11
17
21
28
31
33
41
42
52
57
)
